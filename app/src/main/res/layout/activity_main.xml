<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:clipChildren="false"
    tools:context=".MainActivity">

    <!-- Tab Beranda & Service Report (HomeFragment / ServiceReportFragment) -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragmentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Bottom navigation. Padding bawah diisi tinggi navigation bar di MainActivity -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_bar"
        android:elevation="4dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <FrameLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground">

            <View
                android:id="@+id/indicatorHome"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_gravity="top"
                android:background="@color/nd_accent"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="2dp">

                <ImageView
                    android:id="@+id/iconHome"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_dashboard"
                    app:tint="@color/nd_on_surface_variant" />

                <TextView
                    android:id="@+id/labelHome"
                    style="@style/NdNavLabel"
                    android:text="Beranda" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/navServiceReport"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground">

            <View
                android:id="@+id/indicatorServiceReport"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_gravity="top"
                android:background="@color/nd_accent"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="2dp">

                <ImageView
                    android:id="@+id/iconServiceReport"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_speed"
                    app:tint="@color/nd_on_surface_variant" />

                <TextView
                    android:id="@+id/labelServiceReport"
                    style="@style/NdNavLabel"
                    android:text="Service Report" />
            </LinearLayout>
        </FrameLayout>

        <!-- Ruang untuk FAB di tengah -->
        <View
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="0.9" />

        <LinearLayout
            android:id="@+id/navPlan"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="2dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_event"
                app:tint="@color/nd_on_surface_variant" />

            <TextView
                style="@style/NdNavLabel"
                android:text="Plan" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navAttendance"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="2dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_attendance"
                app:tint="@color/nd_on_surface_variant" />

            <TextView
                style="@style/NdNavLabel"
                android:text="Attendance" />
        </LinearLayout>
    </LinearLayout>

    <!-- FAB tambah draft, menumpang di garis atas bottom bar dengan cincin putih -->
    <FrameLayout
        android:id="@+id/fabContainer"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:background="@drawable/bg_fab_ring"
        android:elevation="8dp"
        android:translationY="6dp"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/bottomBar">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabAdd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:contentDescription="Draft Baru"
            android:src="@drawable/ic_add"
            app:backgroundTint="@color/nd_accent"
            app:elevation="0dp"
            app:fabCustomSize="64dp"
            app:maxImageSize="30dp"
            app:pressedTranslationZ="0dp"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
            app:tint="@color/white" />
    </FrameLayout>

    <!-- Overlay menu aksi cepat saat sebuah draft ditekan & tahan. Salinan baris dan
         tombol aksi ditambahkan secara programatik (lihat MainActivity.showQuickActions) -->
    <FrameLayout
        android:id="@+id/overlayQuickActions"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:elevation="24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:id="@+id/quickActionsScrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#B3000000"
            android:clickable="true"
            android:focusable="true" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
