<?xml version="1.0" encoding="utf-8"?>
<!-- Chip kategori Service Report: terpilih = navy dengan garis marun di bawah -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/nd_accent" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item android:bottom="3dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/nd_primary" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <stroke android:width="1dp" android:color="@color/nd_input_border" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
